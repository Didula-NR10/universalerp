# Vite proxies /api to http://localhost:8080 during local development.
VITE_API_BASE_URL=/api
# On Render, the Blueprint sets VITE_API_ORIGIN to the backend's public URL.
# For a custom API domain, set VITE_API_BASE_URL=https://api.example.com/api
# Optional only when running the backend foundation profile:
# VITE_AUTH_MODE=foundation
