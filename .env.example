# Backend: use the PostgreSQL connection details from your Supabase project.
# Copy values into your backend deployment environment. Spring does not load this file automatically.
# Use the host, port, database, and user shown by Supabase for your chosen connection method.
DB_URL=jdbc:postgresql://YOUR_SUPABASE_DATABASE_HOST:YOUR_PORT/postgres?sslmode=require
DB_USERNAME=YOUR_SUPABASE_DATABASE_USER
DB_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD
# Optional: use a separate migration account and tune the application connection pool.
# MIGRATION_DB_URL=jdbc:postgresql://YOUR_SUPABASE_DATABASE_HOST:YOUR_PORT/postgres?sslmode=require
# MIGRATION_DB_USERNAME=YOUR_MIGRATION_USER
# MIGRATION_DB_PASSWORD=YOUR_MIGRATION_PASSWORD
# DB_POOL_MAX_SIZE=5
AUTH_JWT_SECRET=GENERATE_A_RANDOM_BASE64_VALUE_OF_AT_LEAST_32_BYTES
AUTH_JWT_ISSUER=universal-erp
AUTH_JWT_AUDIENCE=erp
CORS_ALLOWED_ORIGIN=https://YOUR_FRONTEND_DOMAIN
